# HTTPS (and the live WebSocket feed) for the Kohaku backend. Caddy gets the certificate itself.
# setup.sh writes this to /etc/caddy/Caddyfile with KOHAKU_DOMAIN replaced.
KOHAKU_DOMAIN {
	encode gzip
	reverse_proxy 127.0.0.1:8790
}

# Mainnet on the same server (EDGE_PORT=8800 in .env.mainnet), on its own domain:
# kohaku-mainnet.example.org {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:8800
# }
