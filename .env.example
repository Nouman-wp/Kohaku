# ─────────────────────────────────────────────────────────────────────────────
# Kohaku configuration. Copy to .env and fill in. `pnpm dev` writes a working
# local .env automatically (anvil dev keys) if none exists.
# Never commit real keys. Every key below is a 0x-prefixed 32-byte hex string.
# ─────────────────────────────────────────────────────────────────────────────

# Network: local | hashkey-testnet | hashkey
KOHAKU_CHAIN=local
# RPC_URL=https://testnet.hsk.xyz

# ── deployment (pnpm deploy:testnet / deploy:mainnet) ───────────────────────
DEPLOYER_PRIVATE_KEY=
# Leave empty on local to deploy a mock 6-decimal stablecoin.
# Mainnet USDC.e on HashKey Chain: 0x054ed45810DbBAb8B27668922D110669c9D88D0a
SETTLEMENT_TOKEN=
SETTLEMENT_WINDOW=120
WITHDRAWAL_DELAY=600

# ── clearing service ─────────────────────────────────────────────────────────
# Key of the clearing service: posts epochs, records HSP settlements, writes reputation.
CLEARER_PRIVATE_KEY=
PORT=8787
PUBLIC_API_URL=http://localhost:8787
EPOCH_INTAKE_SECONDS=75
EPOCH_CHALLENGE_SECONDS=18
DISPUTE_WINDOW_SECONDS=12
ARBITRATION_TIMEOUT_SECONDS=15
POST_CHUNK_SIZE=120
WRITE_REPUTATION_ONCHAIN=true
ADMIN_TOKEN=change-me
CORS_ORIGIN=*

# ── HSP ──────────────────────────────────────────────────────────────────────
# local:       Kohaku runs HSP's mandate → wallet transfer → signed receipt → verify flow
#              itself (real on-chain transfers, no hosted Coordinator). Labelled in the UI.
# coordinator: settle through the official HSP Coordinator using the organiser's sandbox
#              values and the official SDK (HSPClient / HSPVerifier).
HSP_MODE=local
HSP_COORDINATOR_URL=
HSP_API_KEY=
HSP_CHAIN_NAME=hashkey-testnet
# Adapter address to pin for independent verification (also served at <coordinator>/chains)
HSP_ADAPTER_ADDRESS=
# Path to the built HSP SDK entry, e.g. /path/to/hsp/packages/sdk/dist/index.js
HSP_SDK_PATH=
HSP_WEBHOOK_SECRET=change-me-to-a-long-random-string
# HSP_LOCAL_ADAPTER_KEY=

# ── agent fleet ──────────────────────────────────────────────────────────────
FLEET_PORT=8788
PUBLIC_FLEET_URL=http://localhost:8788
CLEARING_URL=http://localhost:8787
# Seed for the fleet agents' keys (each agent key = keccak(seed, slug)).
FLEET_SEED=
# Operator of the fleet agents (signs intents, funds collateral) and of Rogue.
FLEET_OPERATOR_KEY=
ROGUE_OPERATOR_KEY=
FLEET_BACKGROUND=on
BACKGROUND_INTERVAL_SECONDS=40
# Collateral per agent, orchestrator collateral, agent wallet float (USDC) and gas (native)
COLLATERAL_TARGET=25
ORCHESTRATOR_COLLATERAL=100
WALLET_TARGET=20
GAS_TARGET=0.5
ROGUE_BAD_RATE=0.5
GUEST_SESSIONS_PER_HOUR=20
# Raises the free MyMemory translation quota from 5k to 50k characters/day
MYMEMORY_EMAIL=
# Force the offline corpus / glossary (no Wikipedia or MyMemory calls)
# KOHAKU_OFFLINE=1

# ── web app ──────────────────────────────────────────────────────────────────
VITE_KOHAKU_API=http://localhost:8787
VITE_KOHAKU_FLEET=http://localhost:8788
