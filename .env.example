# ─────────────────────────────────────────────────────────────────────────────
# Kohaku configuration. `pnpm dev` writes a working local .env (anvil dev keys) if
# none exists. For a public network, `node scripts/wallets.mjs testnet|mainnet`
# writes .env.testnet / .env.mainnet with fresh keys; every script takes the
# network name and loads that file (KOHAKU_ENV_FILE selects it for the services).
# Never commit real keys. Every key below is a 0x-prefixed 32-byte hex string.
# ─────────────────────────────────────────────────────────────────────────────

# Network: local | hashkey-testnet | hashkey
KOHAKU_CHAIN=local
# RPC_URL=https://testnet.hsk.xyz          (mainnet: https://mainnet.hsk.xyz)

# ── deployment (node scripts/deploy.mjs local|testnet|mainnet) ───────────────
DEPLOYER_PRIVATE_KEY=
# Empty: deploy Kohaku Test USDC (6 decimals, EIP-3009, open faucet). Refused on mainnet.
# Mainnet: USDC.e 0x054ed45810DbBAb8B27668922D110669c9D88D0a ("Bridged USDC", EIP-3009,
#          EIP-712 domain "Bridged USDC" / "2"). USDT 0xf1b5…9029 has no EIP-3009.
# Testnet: HSP's USDC 0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6 (owner-mint only).
SETTLEMENT_TOKEN=
SETTLEMENT_WINDOW=120
WITHDRAWAL_DELAY=600

# ── clearing service ─────────────────────────────────────────────────────────
# Key of the clearing service: posts epochs, records HSP settlements, writes reputation.
CLEARER_PRIVATE_KEY=
PORT=8787
# Public base for links and the HSP gateway (on a public deployment: the website's domain)
PUBLIC_API_URL=http://localhost:8787
EPOCH_INTAKE_SECONDS=75
EPOCH_CHALLENGE_SECONDS=18
DISPUTE_WINDOW_SECONDS=12
ARBITRATION_TIMEOUT_SECONDS=15
POST_CHUNK_SIZE=120
WRITE_REPUTATION_ONCHAIN=true
# write scores on chain every N epochs (they are cumulative, nothing is lost)
REPUTATION_EPOCH_STRIDE=1
# keep an epoch with no IOUs open instead of finalising it empty (default: on, except local)
# EPOCH_EXTEND_IDLE=true
ADMIN_TOKEN=change-me
CORS_ORIGIN=*

# ── HSP (HashKey Settlement Protocol) ────────────────────────────────────────
# The clearing service is the HSP merchant: every net debt is an HSP order (AP2 cart
# mandate), paid by the debtor agent with an x402 payment mandate carrying an EIP-3009
# authorization whose nonce is the settlement order reference.
#   local:    Kohaku's own gateway serves HashKey Merchant's API at <PUBLIC_API_URL>/hsp and
#             relays the authorizations (real on-chain transfers). Labelled everywhere.
#   merchant: HashKey Merchant itself. HSP_BASE_URL, HSP_APP_KEY and HSP_APP_SECRET come from
#             HashKey onboarding; register the merchant public key that
#             `node scripts/wallets.mjs <network> --show` prints.
HSP_MODE=local
# HashKey Merchant QA (testnet): https://merchant-qa.hashkeymerchant.com
HSP_BASE_URL=
HSP_APP_KEY=
HSP_APP_SECRET=
HSP_MERCHANT_NAME=Kohaku
# secp256k1 key (0x-hex or PEM) that signs merchant_authorization
HSP_MERCHANT_PRIVATE_KEY=
# x402 network name in the cart mandate: hashkey-testnet | hashkey
HSP_NETWORK=
HSP_COIN=USDC
HSP_CART_TTL_SECONDS=7200
# local mode: the key that relays EIP-3009 authorizations and pays their gas
HSP_GATEWAY_RELAYER_KEY=

# ── agent fleet ──────────────────────────────────────────────────────────────
FLEET_PORT=8788
# Public base of the agent cards (written on chain at registration: use a stable domain)
PUBLIC_FLEET_URL=http://localhost:8788
CLEARING_URL=http://localhost:8787
# Seed for the fleet agents' keys (each agent key = keccak(seed, slug)).
FLEET_SEED=
# Operator of the fleet agents (signs intents, funds collateral) and of Rogue.
FLEET_OPERATOR_KEY=
ROGUE_OPERATOR_KEY=
FLEET_BACKGROUND=on
BACKGROUND_INTERVAL_SECONDS=40
# Collateral per agent, orchestrator collateral, agent wallet float (USDC) and validator gas (native)
COLLATERAL_TARGET=25
ORCHESTRATOR_COLLATERAL=100
WALLET_TARGET=20
GAS_TARGET=0.5
ROGUE_BAD_RATE=0.5
GUEST_SESSIONS_PER_HOUR=20
# Raises the free MyMemory translation quota from 5k to 50k characters/day
MYMEMORY_EMAIL=
# Force the offline corpus / glossary (no Wikipedia or MyMemory calls)
# KOHAKU_OFFLINE=1

# ── web app ──────────────────────────────────────────────────────────────────
VITE_KOHAKU_API=http://localhost:8787
VITE_KOHAKU_FLEET=http://localhost:8788
# Live feed origin when the site's host proxies REST but not WebSockets (Vercel)
# VITE_KOHAKU_WS=wss://backend.example.com

# ── edge / hosting (node scripts/serve.mjs <network>) ────────────────────────
# One port in front of the clearing service and the fleet
# EDGE_PORT=8790
